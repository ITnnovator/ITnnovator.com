# MongoDB Connection
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=itnnovator

# Authentication Secrets (Generate strong random strings)
NEXTAUTH_SECRET=generate_a_strong_random_string_here
JWT_SECRET=generate_another_strong_random_string_here

# Email Configuration
SMTP_RECEIVER=your-email@domain.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# Contact Form Email
CONTACT_RECEIVER_EMAIL=contact@domain.com

# Vercel Blob Storage (if using)
itnnovator_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Environment
NODE_ENV=production
